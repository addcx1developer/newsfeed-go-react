{
  "name": "newsfeed-go-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "print-schema": "go run ./scripts/printSchema.go",
    "relay": "relay-compiler",
    "watch-relay": "relay-compiler --watch",
    "watch-server": "air",
    "watch-vite": "vite",
    "dev": "concurrently npm:watch-* -c auto"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-relay": "^20.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "graphql": "^16.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "relay-compiler": "^21.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.7"
  }
}
